---
import Analytics from "@/components/Analytics.astro";

interface Props {
  title?: string;
  description?: string;
  path?: string;
}
const {
  title = "Aptora — AI Resume Tailoring",
  description = "Aptora tailors the resume you already have to a job description with AI, then compiles a real, professional PDF. Truthful, role-aware, WYSIWYG.",
  path = "",
} = Astro.props;
const SITE = "https://aptora.enally.in";
const canonical = `${SITE}${path}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/webp" href="/favicon.webp" />
    <link rel="apple-touch-icon" href="/aptora_sq.webp" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Aptora" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${SITE}/aptora_rec.webp`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${SITE}/aptora_rec.webp`} />
    <link rel="preconnect" href="https://rsms.me/" />
    <link rel="stylesheet" href="https://rsms.me/inter/inter.css" />
    <Analytics />
  </head>
  <body>
    <slot />
    <style is:global>
      /* Design tokens — Aptora (see docs/DESIGN-SYSTEM.md) */
      :root {
        --bg: #fafaf8;
        --surface: #ffffff;
        --subtle: #f4f4f1;
        --text: #111111;
        --secondary: #6b6b6b;
        --muted: #8a8a86;
        --border: #e5e5e1;
        --accent: #2563eb;
        --success: #16803c;
        --warning: #b7791f;
        --danger: #c24141;
        --radius-input: 10px;
        --radius-card: 14px;
        --shadow-card: 0 1px 2px rgba(0, 0, 0, 0.04), 0 8px 30px rgba(0, 0, 0, 0.06);
        --shadow-sheet: 0 20px 50px rgba(0, 0, 0, 0.08), 0 2px 8px rgba(0, 0, 0, 0.05);
        --mono: ui-monospace, "SF Mono", "JetBrains Mono", Menlo, Consolas, monospace;
      }
      * { box-sizing: border-box; }
      html { font-family: "Inter", system-ui, sans-serif; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        -webkit-font-smoothing: antialiased;
      }
      @media (prefers-reduced-motion: reduce) {
        * { transition: none !important; animation: none !important; }
      }

      /* Account-prompt modal (used in the editor) */
      .modal-scrim { position: fixed; inset: 0; background: rgba(17,17,17,0.35); display: flex; align-items: center; justify-content: center; z-index: 100; }
      .modal { background: #fff; border: 1px solid var(--border); border-radius: 16px; box-shadow: var(--shadow-card); padding: 28px; max-width: 380px; }
      .modal h3 { margin: 0 0 8px; font-size: 18px; }
      .modal p { color: var(--secondary); font-size: 14px; line-height: 1.5; margin: 0 0 20px; }
      .modal-actions { display: flex; gap: 10px; }
      .modal-actions .ui-btn { text-decoration: none; }
    </style>
  </body>
</html>
