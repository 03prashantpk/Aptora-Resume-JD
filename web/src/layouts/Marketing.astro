---
// Shared marketing shell (same premium UI as the FastAPI landing page): Tailwind CDN,
// DM Sans / IBM Plex Mono, the landing nav + footer, and the reveal / nav-scroll /
// mobile-menu scripts. Used by /home and /about so both match the marketing site.
import Analytics from "@/components/Analytics.astro";

interface Props {
  title?: string;
  description?: string;
  path?: string;
  /** active nav link highlight, e.g. "about" */
  active?: string;
}
const {
  title = "Aptora — AI Resume Tailoring",
  description = "Aptora tailors the resume you already have to a job description with AI, then compiles a real, professional PDF.",
  path = "",
  active = "",
} = Astro.props;

const SITE = "https://aptora.enally.in";
const APP = "/"; // the workspace lives at the site root
const canonical = `${SITE}${path}`;

const NAV = [
  { href: "/home#ai", label: "AI", key: "ai" },
  { href: "/home#workflow", label: "How it works", key: "workflow" },
  { href: "/home#templates", label: "Templates", key: "templates" },
  { href: "/about", label: "About", key: "about" },
  { href: "/contact", label: "Contact", key: "contact" },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#FAFAF8" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Aptora" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${SITE}/aptora_rec.webp`} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/webp" href="/favicon.webp" />
    <link rel="apple-touch-icon" href="/aptora_sq.webp" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <script is:inline src="https://cdn.tailwindcss.com"></script>
    <script is:inline>
      tailwind.config = {
        theme: { extend: { fontFamily: {
          sans: ["DM Sans", "ui-sans-serif", "system-ui"],
          mono: ["IBM Plex Mono", "ui-monospace", "SFMono-Regular"],
        } } },
      };
    </script>
    <Analytics />
    <style is:global>
      :root {
        --bg:#fafaf8; --surface:#fff; --ink:#111; --muted:#696967;
        --soft:#f3f3f0; --line:#e5e5e1; --blue:#2563eb; --green:#16803c;
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body { margin:0; background:var(--bg); color:var(--ink); font-family:"DM Sans",ui-sans-serif,system-ui,sans-serif; -webkit-font-smoothing:antialiased; }
      ::selection { background:#dbeafe; color:#111; }
      .grid-bg {
        background-image:
          linear-gradient(to right, rgba(17,17,17,.045) 1px, transparent 1px),
          linear-gradient(to bottom, rgba(17,17,17,.045) 1px, transparent 1px);
        background-size:36px 36px;
        -webkit-mask-image: linear-gradient(to bottom, black 0%, rgba(0,0,0,.65) 48%, transparent 100%);
        mask-image: linear-gradient(to bottom, black 0%, rgba(0,0,0,.65) 48%, transparent 100%);
      }
      .hero-glow { background: radial-gradient(circle at 50% 38%, rgba(37,99,235,.08), transparent 35%); }
      .paper { box-shadow: 0 24px 70px rgba(0,0,0,.11), 0 2px 8px rgba(0,0,0,.07); }
      .hairline { border-color: var(--line); }
      .lift { transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease; }
      .lift:hover { transform: translateY(-3px); box-shadow: 0 18px 45px rgba(0,0,0,.07); border-color:#d4d4d0; }
      .reveal { opacity:0; transform: translateY(14px); transition: opacity .55s ease, transform .55s ease; }
      .reveal.show { opacity:1; transform: translateY(0); }
      .mono { font-family:"IBM Plex Mono",ui-monospace,monospace; }
      .btn-saas-primary { background:#111; color:#fff; box-shadow:0 1px 2px rgba(0,0,0,.12), inset 0 1px 0 rgba(255,255,255,.12); transition:all .16s cubic-bezier(.4,0,.2,1); }
      .btn-saas-primary:hover { background:#222; box-shadow:0 4px 12px rgba(0,0,0,.18); transform:translateY(-1px); }
      .btn-saas-secondary { background:#fff; border:1px solid var(--line); box-shadow:0 1px 2px rgba(0,0,0,.03); transition:all .16s cubic-bezier(.4,0,.2,1); }
      .btn-saas-secondary:hover { background:#fafaf9; border-color:#cbd5e1; transform:translateY(-1px); }
      #mainHeader { transition: max-width .3s cubic-bezier(.4,0,.2,1); }
      .nav-scrolled {
        background: rgba(250,250,248,.88) !important;
        backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
        border:1px solid rgba(229,229,225,.8) !important;
        box-shadow:0 10px 30px -5px rgba(0,0,0,.06), 0 4px 12px -2px rgba(0,0,0,.03) !important;
      }
      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior:auto; }
        *, *::before, *::after { animation-duration:.01ms !important; transition-duration:.01ms !important; }
      }
    </style>
  </head>
  <body>
    <!-- NAV -->
    <header id="mainHeader" class="sticky top-[1%] z-50 mx-auto max-w-7xl px-3 sm:px-5 lg:px-8 transition-all duration-300">
      <div id="navInner" class="flex h-16 w-full items-center justify-between px-5 lg:px-8 rounded-2xl transition-all duration-300 bg-transparent border border-transparent">
        <a href="/home" class="flex items-center gap-2.5 font-semibold tracking-[-.02em]">
          <img src="/aptora_sq.webp" alt="Aptora" class="h-8 w-8 rounded-lg object-contain" />
          <span>Aptora</span>
        </a>
        <nav class="hidden items-center gap-7 text-sm text-[#666] md:flex">
          {NAV.map((n) => (
            <a href={n.href} class={`transition hover:text-[#111] ${active === n.key ? "text-[#111] font-medium" : ""}`}>{n.label}</a>
          ))}
        </nav>
        <div class="flex items-center gap-3">
          <a href={APP} class="hidden text-sm font-medium text-[#555] sm:block">Open app</a>
          <a href={APP} class="rounded-xl btn-saas-primary px-4 py-2.5 text-sm font-semibold">Start tailoring</a>
          <button id="menuBtn" class="rounded-lg border hairline p-2 md:hidden" aria-label="Open menu" aria-expanded="false">
            <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
          </button>
        </div>
      </div>
      <div id="mobileMenu" class="hidden mt-2 rounded-2xl border hairline bg-[#FAFAF8]/95 backdrop-blur-md px-5 py-4 shadow-lg md:hidden">
        <div class="flex flex-col gap-4 text-sm text-[#555]">
          {NAV.map((n) => <a href={n.href}>{n.label}</a>)}
          <a href={APP} class="font-semibold text-[#111]">Start tailoring</a>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <!-- FOOTER -->
    <footer class="bg-[#111] text-[#999]">
      <div class="mx-auto flex max-w-7xl flex-col gap-5 border-t border-white/10 px-5 py-7 text-xs sm:flex-row sm:items-center sm:justify-between lg:px-8">
        <div class="flex items-center gap-2.5">
          <img src="/aptora_rec.webp" alt="Aptora" class="h-7 w-auto object-contain" />
        </div>
        <div class="flex flex-wrap gap-5">
          <a href="/home#ai" class="transition hover:text-white">AI</a>
          <a href="/home#workflow" class="transition hover:text-white">How it works</a>
          <a href="/about" class="transition hover:text-white">About</a>
          <a href="/contact" class="transition hover:text-white">Contact</a>
          <a href="/terms" class="transition hover:text-white">Terms</a>
          <a href="/privacy" class="transition hover:text-white">Privacy</a>
        </div>
        <div class="flex items-center gap-2">
          <span>Developed by <a href="https://enally.in" target="_blank" rel="noopener noreferrer" class="text-white hover:underline">Enally.in</a> with <span style="color:#f43f5e;">💝</span></span>
        </div>
      </div>
    </footer>

    <script is:inline>
      (() => {
        const menuBtn = document.getElementById("menuBtn");
        const mobileMenu = document.getElementById("mobileMenu");
        menuBtn?.addEventListener("click", () => {
          const open = mobileMenu.classList.toggle("hidden") === false;
          menuBtn.setAttribute("aria-expanded", String(open));
        });
        mobileMenu?.querySelectorAll("a").forEach((link) =>
          link.addEventListener("click", () => {
            mobileMenu.classList.add("hidden");
            menuBtn?.setAttribute("aria-expanded", "false");
          }),
        );
        const mainHeader = document.getElementById("mainHeader");
        const navInner = document.getElementById("navInner");
        const onScroll = () => {
          if (window.scrollY > 16) {
            navInner?.classList.add("nav-scrolled");
            mainHeader?.classList.remove("max-w-7xl");
            mainHeader?.classList.add("max-w-6xl");
          } else {
            navInner?.classList.remove("nav-scrolled");
            mainHeader?.classList.remove("max-w-6xl");
            mainHeader?.classList.add("max-w-7xl");
          }
        };
        window.addEventListener("scroll", onScroll, { passive: true });
        onScroll();
        const obs = new IntersectionObserver((entries) => {
          entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add("show"); obs.unobserve(e.target); } });
        }, { threshold: 0.08 });
        document.querySelectorAll(".reveal").forEach((el) => obs.observe(el));
      })();
    </script>
  </body>
</html>
