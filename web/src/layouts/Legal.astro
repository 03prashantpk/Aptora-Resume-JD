---
interface Props { title: string; }
const { title } = Astro.props;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — Aptora</title>
    <link rel="preconnect" href="https://rsms.me/" />
    <link rel="stylesheet" href="https://rsms.me/inter/inter.css" />
  </head>
  <body>
    <header class="lg-top">
      <a href="/" class="lg-brand"><img src="/aptora_sq.webp" alt="Aptora" /> <span>Aptora</span></a>
      <nav class="lg-nav">
        <a href="/terms">Terms</a>
        <a href="/privacy">Privacy</a>
        <a href="/" class="lg-app">Open app</a>
      </nav>
    </header>
    <main class="lg-main">
      <slot />
    </main>
    <footer class="lg-foot">
      <span>© 2026 Aptora, by Enally.</span>
      <span><a href="/terms">Terms</a> · <a href="/privacy">Privacy</a></span>
    </footer>

    <style is:global>
      :root { --bg:#fafaf8; --surface:#fff; --text:#111; --secondary:#6b6b6b; --muted:#8a8a86; --border:#e5e5e1; --accent:#2563eb; }
      * { box-sizing: border-box; }
      html { font-family: "Inter", system-ui, sans-serif; }
      body { margin: 0; background: var(--bg); color: var(--text); -webkit-font-smoothing: antialiased; }
      a { color: inherit; text-decoration: none; }
      .lg-top { position: sticky; top: 0; display: flex; align-items: center; justify-content: space-between; height: 60px; padding: 0 24px; border-bottom: 1px solid var(--border); background: rgba(250,250,248,0.9); backdrop-filter: blur(8px); }
      .lg-brand { display: inline-flex; align-items: center; gap: 8px; font-weight: 600; }
      .lg-brand img { height: 24px; width: 24px; object-fit: contain; }
      .lg-nav { display: flex; align-items: center; gap: 18px; font-size: 14px; color: var(--secondary); }
      .lg-nav a:hover { color: var(--text); }
      .lg-app { background: #111; color: #fff !important; padding: 8px 14px; border-radius: 9px; }
      .lg-main { max-width: 760px; margin: 0 auto; padding: 56px 24px 80px; }
      .lg-main h1 { font-size: 34px; font-weight: 600; letter-spacing: -0.03em; margin: 0 0 8px; }
      .lg-updated { color: var(--muted); font-size: 13px; margin: 0 0 40px; }
      .lg-main h2 { font-size: 18px; font-weight: 600; margin: 32px 0 10px; }
      .lg-main p, .lg-main li { color: var(--secondary); line-height: 1.7; font-size: 15px; }
      .lg-main ul { padding-left: 20px; }
      .lg-foot { max-width: 760px; margin: 0 auto; padding: 24px; border-top: 1px solid var(--border); display: flex; justify-content: space-between; font-size: 13px; color: var(--muted); }
      .lg-foot a:hover { color: var(--text); }
    </style>
  </body>
</html>
