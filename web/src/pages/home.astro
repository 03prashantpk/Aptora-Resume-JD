---
import Marketing from "@/layouts/Marketing.astro";

const APP_URL = "https://aptora.enally.in/";

const testimonials = [
  { name: "Aditya M.", role: "Software Engineer", quote: "I stopped rewriting my resume for every role. I paste the job description, Aptora shows me exactly what to bring forward, and the tailored PDF looks like a designer made it. It saved me hours every single week.", accent: "dark", shape: "tall" },
  { name: "Sara R.", role: "Product Designer", quote: "The gap analysis told me which real projects to emphasize instead of adding fluff.", accent: "plain", shape: "square" },
  { name: "Jordan D.", role: "Data Analyst", quote: "Preview matched the download exactly. No surprise formatting when I sent it — that alone sold me.", accent: "plain", shape: "std" },
  { name: "Meera K.", role: "Marketing Manager", quote: "It kept my experience honest but made it read like it belonged to the role. Two interviews the same week I started using it.", accent: "blue", shape: "wide" },
  { name: "Liam T.", role: "Backend Developer", quote: "The LaTeX output is genuinely clean.", accent: "plain", shape: "square" },
  { name: "Priya N.", role: "UX Researcher", quote: "Finally a tool that doesn't invent fake achievements. It just sharpened the real ones I already had on the page.", accent: "green", shape: "std" },
  { name: "Noah B.", role: "New grad", quote: "No blank page. I uploaded my old resume and it guided the rest.", accent: "plain", shape: "std" },
  { name: "Chen W.", role: "DevOps Engineer", quote: "One document — preview and export in the same place. Zero back-and-forth.", accent: "plain", shape: "square" },
  { name: "Zoya A.", role: "Content Strategist", quote: "The role-fit score made it obvious what a recruiter would actually care about, so I stopped guessing and started aligning.", accent: "plain", shape: "wide" },
  { name: "Rahul V.", role: "ML Engineer", quote: "Tailored three applications in the time it used to take me to do one.", accent: "dark", shape: "std" },
  { name: "Emma L.", role: "Frontend Developer", quote: "It reordered my experience so the most relevant work landed first. Small change, big difference.", accent: "plain", shape: "std" },
  { name: "Kabir S.", role: "Career switcher", quote: "Helped me frame past work for a role I'd never done before — truthfully.", accent: "blue", shape: "square" },
  { name: "Hana Y.", role: "Recruiter", quote: "From the other side of the desk: Aptora resumes are easy to skim and the relevant experience is right where I look first.", accent: "green", shape: "wide" },
];

function avatarUrl(name: string) {
  const seed = name.replace(/[\s.]/g, "").toLowerCase();
  return `https://api.dicebear.com/9.x/notionists/svg?seed=${seed}&backgroundColor=e7ecff,e6f4ea,faf0e6,f1eafd,f3f3f0&radius=50&scale=110`;
}

function cardClasses(accent: string) {
  if (accent === "dark") return "border hairline bg-[#111] text-white";
  if (accent === "blue") return "border border-[#dbeafe] bg-[#f8fbff]";
  if (accent === "green") return "border border-[#cdead6] bg-[#f6fbf7]";
  return "border hairline bg-[#FAFAF8]";
}
function quoteClasses(accent: string) {
  return accent === "dark" ? "text-[#e8e8e8]" : "text-[#333]";
}
function roleClasses(accent: string) {
  if (accent === "dark") return "text-[#999]";
  if (accent === "blue") return "text-[#5d6b80]";
  if (accent === "green") return "text-[#4a7a58]";
  return "text-[#888]";
}
function spanClass(shape: string) {
  if (shape === "wide") return "col-span-2";
  if (shape === "tall") return "row-span-2";
  return "";
}
function quoteSize(shape: string) {
  return shape === "tall" || shape === "wide" ? "text-base leading-relaxed" : "text-sm leading-6";
}
---

<Marketing
  title="Aptora — Make your resume fit the job"
  description="Upload the resume you already have and a job description. Aptora's AI tailors your real experience for the role and compiles a real, professional PDF."
  path="/home"
>
  <!-- HERO -->
  <section class="relative overflow-hidden">
    <div class="grid-bg pointer-events-none absolute inset-0"></div>
    <div class="hero-glow pointer-events-none absolute inset-0"></div>
    <div class="relative mx-auto max-w-7xl px-5 pb-16 pt-20 sm:pt-28 lg:px-8 lg:pb-24 lg:pt-32">
      <div class="mx-auto max-w-4xl text-center">
        <div class="reveal inline-flex items-center gap-2 rounded-full border hairline bg-white px-3.5 py-2 text-xs font-medium text-[#555] shadow-sm">
          <span class="h-1.5 w-1.5 rounded-full bg-[#16803C]"></span>
          AI-powered resume tailoring
        </div>
        <h1 class="reveal mt-7 text-5xl font-semibold leading-[1.02] tracking-[-.055em] sm:text-6xl lg:text-[76px]">
          Make your resume<br />
          <span class="text-[#666]">fit the job.</span>
        </h1>
        <p class="reveal mx-auto mt-7 max-w-2xl text-base leading-7 text-[#666] sm:text-lg">
          Upload the resume you already have. Add the job description.
          AI understands both, finds what matters, and tailors your real experience
          for the role — without making things up.
        </p>
        <div class="reveal mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
          <a href={APP_URL} class="inline-flex w-full items-center justify-center gap-2 rounded-xl btn-saas-primary px-5 py-3.5 text-sm font-semibold sm:w-auto">
            Tailor my resume
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
          <a href="#workflow" class="inline-flex w-full items-center justify-center rounded-xl btn-saas-secondary px-5 py-3.5 text-sm font-semibold text-[#333] sm:w-auto">
            See how it works
          </a>
        </div>
        <p class="mt-4 text-xs text-[#8a8a86]">Start with your existing resume. No blank page required.</p>
      </div>

      <!-- PRODUCT PREVIEW (mock workspace UI) -->
      <div class="reveal relative mx-auto mt-16 max-w-6xl lg:mt-20">
        <div class="overflow-hidden rounded-2xl border border-[#dcdcd7] bg-white paper">
          <!-- Browser chrome -->
          <div class="flex h-11 items-center justify-between border-b hairline bg-[#fbfbf9] px-4">
            <div class="flex items-center gap-1.5">
              <span class="h-2.5 w-2.5 rounded-full bg-[#ddd]"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-[#ddd]"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-[#ddd]"></span>
            </div>
            <div class="mono text-[10px] text-[#888]">APTORA / WORKSPACE</div>
            <div class="flex items-center gap-2 text-[10px] text-[#777]">
              <span class="h-1.5 w-1.5 rounded-full bg-[#16803C]"></span>
              Ready
            </div>
          </div>
          <!-- 3-col workspace -->
          <div class="grid min-h-[520px] lg:grid-cols-[190px_1fr_250px]">
            <!-- left rail -->
            <aside class="hidden border-r hairline bg-[#fafaf8] p-4 lg:block">
              <p class="mono text-[9px] uppercase tracking-[.16em] text-[#999]">Workspace</p>
              <div class="mt-4 space-y-1 text-xs">
                <div class="rounded-lg bg-white px-3 py-2 font-medium text-[#222] shadow-sm">Resume</div>
                <div class="px-3 py-2 text-[#777]">Job description</div>
                <div class="px-3 py-2 text-[#777]">AI analysis</div>
                <div class="px-3 py-2 text-[#777]">Tailored version</div>
              </div>
              <div class="mt-8 border-t hairline pt-5">
                <p class="mono text-[9px] uppercase tracking-[.16em] text-[#999]">Document</p>
                <div class="mt-3 rounded-lg border hairline bg-white p-3">
                  <div class="h-1.5 w-16 rounded bg-[#222]"></div>
                  <div class="mt-2 h-1 w-24 rounded bg-[#ddd]"></div>
                  <div class="mt-1 h-1 w-20 rounded bg-[#ddd]"></div>
                </div>
              </div>
            </aside>
            <!-- preview pane -->
            <div class="relative bg-[#e9e9e6] p-5 sm:p-8">
              <div class="mb-4 flex items-center justify-between lg:hidden">
                <span class="text-xs font-medium text-[#555]">Tailored preview</span>
                <span class="rounded-full bg-white px-2.5 py-1 text-[10px] text-[#777]">1 page</span>
              </div>
              <div class="paper mx-auto max-w-[560px] bg-white px-7 py-8 text-[#222] sm:px-10 sm:py-9">
                <div class="flex items-start justify-between gap-6 border-b border-[#222] pb-4">
                  <div>
                    <div class="text-xl font-bold tracking-[-.03em]">Alex Morgan</div>
                    <div class="mt-1 text-[9px] font-medium text-[#444]">Product Engineer · Software Development</div>
                  </div>
                  <div class="text-right text-[7.5px] leading-[1.5] text-[#666]">
                    alex.morgan@example.test<br />
                    +1 (415) 555&#8209;0142 · San Francisco, CA<br />
                    linkedin.com/in/alexmorgan · github.com/alexm
                  </div>
                </div>
                <div class="mt-5 grid gap-[14px] text-[8px] leading-[1.55]">
                  <div>
                    <div class="mb-1.5 text-[8px] font-bold uppercase tracking-[.12em]">Summary</div>
                    <p class="text-[#555]">Product engineer with 5+ years building reliable web products with React, TypeScript and cloud infrastructure. Focused on turning complex workflows into simple user experiences that ship and scale.</p>
                  </div>
                  <div>
                    <div class="mb-1.5 text-[8px] font-bold uppercase tracking-[.12em]">Experience</div>
                    <div class="flex items-baseline justify-between">
                      <div class="font-semibold">Senior Product Engineer · Example Labs</div>
                      <div class="text-[7.5px] text-[#888]">2022 — Present</div>
                    </div>
                    <div class="text-[7.5px] italic text-[#888]">San Francisco, CA</div>
                    <ul class="mt-1.5 ml-3 list-disc space-y-1 text-[#555] marker:text-[#bbb]">
                      <li>Led the redesign of a customer workflow used by 40k+ users, lifting task completion 28%.</li>
                      <li>Cut page load time from 3.1s to 0.9s by reworking the data layer and caching strategy.</li>
                      <li>Mentored 3 engineers and set the team's React + TypeScript review standards.</li>
                    </ul>
                    <div class="mt-2.5 flex items-baseline justify-between">
                      <div class="font-semibold">Software Engineer · Northwind Systems</div>
                      <div class="text-[7.5px] text-[#888]">2019 — 2022</div>
                    </div>
                    <ul class="mt-1.5 ml-3 list-disc space-y-1 text-[#555] marker:text-[#bbb]">
                      <li>Shipped billing and onboarding features across a React/Node stack serving 12k accounts.</li>
                      <li>Built CI checks that reduced production regressions by roughly 35%.</li>
                    </ul>
                  </div>
                  <div>
                    <div class="mb-1.5 text-[8px] font-bold uppercase tracking-[.12em]">Selected Projects</div>
                    <div class="flex items-baseline justify-between">
                      <div class="font-semibold">Workflow Platform</div>
                      <div class="text-[7.5px] text-[#888]">React · Node.js · PostgreSQL</div>
                    </div>
                    <p class="mt-1 text-[#555]">Designed a structured pipeline that transforms complex input into clear, actionable output — adopted by two internal teams.</p>
                  </div>
                  <div class="grid grid-cols-2 gap-5 border-t hairline pt-3">
                    <div>
                      <div class="mb-1.5 text-[8px] font-bold uppercase tracking-[.12em]">Skills</div>
                      <p class="text-[#555]">React · TypeScript · Node.js · PostgreSQL · AWS · Docker · GraphQL</p>
                    </div>
                    <div>
                      <div class="mb-1.5 text-[8px] font-bold uppercase tracking-[.12em]">Education</div>
                      <p class="text-[#555]">B.Tech, Computer Science<br /><span class="text-[7.5px] text-[#888]">State University · 2019</span></p>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <!-- AI insights rail -->
            <aside class="border-l hairline bg-white p-5">
              <div class="flex items-center gap-2">
                <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-[#111] text-white">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3v18M3 12h18"/><path d="m5 5 14 14M19 5 5 19"/></svg>
                </span>
                <div>
                  <div class="text-xs font-semibold">AI insights</div>
                  <div class="text-[10px] text-[#888]">Based on this role</div>
                </div>
              </div>
              <div class="mt-5 rounded-xl border hairline bg-[#fafaf8] p-3">
                <div class="flex items-center justify-between">
                  <span class="text-[10px] font-medium">Role alignment</span>
                  <span class="text-xs font-semibold">Strong</span>
                </div>
                <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-[#e7e7e3]">
                  <div class="h-full w-[82%] rounded-full bg-[#16803C]"></div>
                </div>
              </div>
              <div class="mt-3 space-y-2">
                <div class="rounded-xl border hairline p-3">
                  <div class="text-[10px] font-semibold">Matched evidence</div>
                  <div class="mt-1 text-[10px] leading-4 text-[#777]">React, cloud infrastructure, product delivery</div>
                </div>
                <div class="rounded-xl border border-[#dbeafe] bg-[#f8fbff] p-3">
                  <div class="text-[10px] font-semibold text-[#1d4ed8]">Opportunity</div>
                  <div class="mt-1 text-[10px] leading-4 text-[#5d6b80]">Bring your workflow ownership closer to the top.</div>
                </div>
                <div class="rounded-xl border hairline p-3">
                  <div class="text-[10px] font-semibold">AI suggestion</div>
                  <div class="mt-1 text-[10px] leading-4 text-[#777]">Emphasize the project delivery evidence already present.</div>
                </div>
              </div>
            </aside>
          </div>
        </div>
        <div class="mx-auto mt-4 flex max-w-3xl flex-wrap items-center justify-center gap-x-5 gap-y-2 text-[11px] text-[#888]">
          <span>Upload once</span><span>·</span><span>AI understands context</span><span>·</span><span>Preview the result</span><span>·</span><span>Export when ready</span>
        </div>
      </div>
    </div>
  </section>

  <!-- SOCIAL PROOF BAND -->
  <section class="border-t hairline bg-[#F7F7F5]">
    <div class="mx-auto max-w-6xl px-5 py-14 lg:px-8 lg:py-16">
      <div class="reveal flex flex-col items-center justify-center gap-3 sm:flex-row sm:gap-4">
        <div class="flex -space-x-2.5">
          {["Aditya M.", "Sara R.", "Jordan D.", "Meera K.", "Priya N."].map((name) => (
            <img src={avatarUrl(name)} alt={name} loading="lazy" class="h-9 w-9 rounded-full border-2 border-[#F7F7F5] bg-white object-cover" />
          ))}
          <span class="flex h-9 w-9 items-center justify-center rounded-full border-2 border-[#F7F7F5] bg-[#111] text-[9px] font-semibold text-white">+2k</span>
        </div>
        <div class="flex items-center gap-2">
          <div class="flex items-center gap-0.5 text-[#f5a623]">
            {[1,2,3,4,5].map(() => (
              <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z"/></svg>
            ))}
          </div>
          <span class="text-sm text-[#666]"><span class="font-semibold text-[#111]">4.9/5</span> from job seekers who tailored with Aptora</span>
        </div>
      </div>
      <!-- Stat strip -->
      <div class="reveal mx-auto mt-9 grid max-w-3xl grid-cols-1 gap-px overflow-hidden rounded-2xl border hairline bg-[#E5E5E1] text-center sm:grid-cols-3">
        <div class="bg-white px-4 py-7">
          <div class="text-2xl font-semibold tracking-[-.03em] sm:text-3xl">2 min</div>
          <div class="mt-1 text-xs text-[#777]">From upload to tailored draft</div>
        </div>
        <div class="bg-white px-4 py-7">
          <div class="text-2xl font-semibold tracking-[-.03em] sm:text-3xl">0</div>
          <div class="mt-1 text-xs text-[#777]">Invented facts, ever</div>
        </div>
        <div class="bg-white px-4 py-7">
          <div class="text-2xl font-semibold tracking-[-.03em] sm:text-3xl">1 PDF</div>
          <div class="mt-1 text-xs text-[#777]">Preview equals download</div>
        </div>
      </div>
    </div>
  </section>

  <!-- AI -->
  <section id="ai" class="border-t hairline bg-white">
    <div class="mx-auto max-w-7xl px-5 py-24 lg:px-8 lg:py-32">
      <div class="grid gap-14 lg:grid-cols-[.85fr_1.15fr] lg:items-start">
        <div class="reveal">
          <div class="mono text-[10px] font-medium uppercase tracking-[.18em] text-[#888]">The AI layer</div>
          <h2 class="mt-4 text-4xl font-semibold tracking-[-.045em] sm:text-5xl">
            AI does more than<br />write bullet points.
          </h2>
          <p class="mt-6 max-w-xl text-base leading-7 text-[#666]">
            The useful part is understanding the relationship between your experience
            and the role. Aptora turns both into structured context before it starts
            suggesting changes.
          </p>
          <div class="mt-8 rounded-2xl border hairline bg-[#FAFAF8] p-5">
            <div class="flex items-start gap-3">
              <span class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-[#111] text-white">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3v18M3 12h18"/></svg>
              </span>
              <div>
                <div class="text-sm font-semibold">Grounded by your source</div>
                <p class="mt-1.5 text-xs leading-5 text-[#777]">
                  AI can improve wording and relevance. It should not manufacture
                  experience, companies, dates, skills, metrics or achievements.
                </p>
              </div>
            </div>
          </div>
        </div>
        <div class="reveal grid gap-3 sm:grid-cols-2">
          <article class="lift rounded-2xl border hairline bg-[#FAFAF8] p-6">
            <div class="mono text-xs text-[#999]">01</div>
            <h3 class="mt-8 text-lg font-semibold">Understand</h3>
            <p class="mt-2 text-sm leading-6 text-[#6b6b6b]">Extracts your experience, projects, skills, education and achievements from the resume you already have.</p>
          </article>
          <article class="lift rounded-2xl border hairline bg-[#FAFAF8] p-6">
            <div class="mono text-xs text-[#999]">02</div>
            <h3 class="mt-8 text-lg font-semibold">Read the role</h3>
            <p class="mt-2 text-sm leading-6 text-[#6b6b6b]">Breaks a job description into responsibilities, skills, technologies, qualifications and important language.</p>
          </article>
          <article class="lift rounded-2xl border hairline bg-[#FAFAF8] p-6">
            <div class="mono text-xs text-[#999]">03</div>
            <h3 class="mt-8 text-lg font-semibold">Find the gaps</h3>
            <p class="mt-2 text-sm leading-6 text-[#6b6b6b]">Shows what already matches, what is weak, what is missing and where existing evidence can be made clearer.</p>
          </article>
          <article class="lift rounded-2xl border hairline bg-[#FAFAF8] p-6">
            <div class="mono text-xs text-[#999]">04</div>
            <h3 class="mt-8 text-lg font-semibold">Tailor the content</h3>
            <p class="mt-2 text-sm leading-6 text-[#6b6b6b]">Rewrites, shortens, reorders and emphasizes relevant evidence without changing the truth of your experience.</p>
          </article>
        </div>
      </div>
    </div>
  </section>

  <!-- WORKFLOW -->
  <section id="workflow" class="border-t hairline bg-[#F7F7F5]">
    <div class="mx-auto max-w-7xl px-5 py-24 lg:px-8 lg:py-32">
      <div class="reveal max-w-2xl">
        <div class="mono text-[10px] font-medium uppercase tracking-[.18em] text-[#888]">One focused workflow</div>
        <h2 class="mt-4 text-4xl font-semibold tracking-[-.045em] sm:text-5xl">From old resume to role-ready.</h2>
        <p class="mt-5 text-base leading-7 text-[#666]">No starting from a blank template. Bring the document you already know and let the workspace guide the transformation.</p>
      </div>
      <div class="mt-14 grid gap-px overflow-hidden rounded-2xl border hairline bg-[#E5E5E1] md:grid-cols-4">
        <div class="bg-white p-6 sm:p-7">
          <div class="mono text-xs text-[#999]">01</div>
          <div class="mt-10 flex h-11 w-11 items-center justify-center rounded-xl bg-[#F1F1EE]">
            <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M8 13h8M8 17h5"/></svg>
          </div>
          <h3 class="mt-5 font-semibold">Upload resume</h3>
          <p class="mt-2 text-sm leading-6 text-[#70706d]">Start with a PDF. Aptora extracts and structures what is already there.</p>
        </div>
        <div class="bg-white p-6 sm:p-7">
          <div class="mono text-xs text-[#999]">02</div>
          <div class="mt-10 flex h-11 w-11 items-center justify-center rounded-xl bg-[#F1F1EE]">
            <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M4 5h16M4 12h11M4 19h16"/><circle cx="19" cy="12" r="2"/></svg>
          </div>
          <h3 class="mt-5 font-semibold">Add the JD</h3>
          <p class="mt-2 text-sm leading-6 text-[#70706d]">Paste or upload the job description you are applying to.</p>
        </div>
        <div class="bg-white p-6 sm:p-7">
          <div class="mono text-xs text-[#999]">03</div>
          <div class="mt-10 flex h-11 w-11 items-center justify-center rounded-xl bg-[#F1F1EE]">
            <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="12" r="8"/><path d="M12 8v8M8 12h8"/></svg>
          </div>
          <h3 class="mt-5 font-semibold">Review AI analysis</h3>
          <p class="mt-2 text-sm leading-6 text-[#70706d]">See matches, gaps, opportunities and the evidence worth bringing forward.</p>
        </div>
        <div class="bg-white p-6 sm:p-7">
          <div class="mono text-xs text-[#999]">04</div>
          <div class="mt-10 flex h-11 w-11 items-center justify-center rounded-xl bg-[#F1F1EE]">
            <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </div>
          <h3 class="mt-5 font-semibold">Tailor &amp; export</h3>
          <p class="mt-2 text-sm leading-6 text-[#70706d]">Choose your trusted document style, review the result and export the finished resume.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- WORKSPACE -->
  <section id="workspace" class="border-t hairline bg-white">
    <div class="mx-auto max-w-7xl px-5 py-24 lg:px-8 lg:py-32">
      <div class="reveal text-center">
        <div class="mono text-[10px] font-medium uppercase tracking-[.18em] text-[#888]">The workspace</div>
        <h2 class="mx-auto mt-4 max-w-3xl text-4xl font-semibold tracking-[-.045em] sm:text-5xl">
          Everything you need to make one strong application.
        </h2>
