---
import Base from "@/layouts/Base.astro";
import Workspace from "@/components/workspace/Workspace.tsx";
---

<Base title="Aptora — Make your experience count">
  <Workspace client:load />

  <style is:global>
    html, body { height: 100%; overflow: hidden; }
    .app { display: flex; flex-direction: column; height: 100vh; }
    .app-body { flex: 1; min-height: 0; display: flex; }

    /* ===================== Menu bar (app menu) ===================== */
    .menubar { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; height: 44px; padding: 0 12px; border-bottom: 1px solid var(--border); background: var(--surface); flex-shrink: 0; }
    .mb-left { display: flex; align-items: center; gap: 2px; }
    .mb-logo { height: 24px; width: 24px; object-fit: contain; margin-right: 10px; display: block; }
    .mb-menu-wrap { position: relative; }
    .mb-dropdown { position: absolute; top: calc(100% + 4px); left: 0; min-width: 160px; background: var(--surface); border: 1px solid var(--border); border-radius: 10px; box-shadow: var(--shadow-card); padding: 5px; z-index: 60; display: flex; flex-direction: column; }
    .mb-dropdown button { text-align: left; font: inherit; font-size: 13px; padding: 7px 10px; border: none; border-radius: 7px; background: transparent; color: var(--text); cursor: pointer; }
    .mb-dropdown button, .mb-dropdown a { display: flex; align-items: center; justify-content: space-between; gap: 12px; text-align: left; font: inherit; font-size: 13px; padding: 7px 10px; border: none; border-radius: 7px; background: transparent; color: var(--text); cursor: pointer; text-decoration: none; }
    .mb-dropdown button:hover:not(:disabled), .mb-dropdown a:hover { background: var(--subtle); }
    .mb-dropdown button:disabled { color: var(--muted); cursor: default; }
    .mb-hint { font-size: 11px; color: var(--muted); background: var(--subtle); border-radius: 20px; padding: 1px 7px; }
    .mb-sep { height: 1px; background: var(--border); margin: 5px 4px; }
    .mb-menu.open { background: var(--subtle); color: var(--text); }

    /* About / Developer popups — on-brand dark, animated */
    .about-scrim { position: fixed; inset: 0; background: rgba(10,10,12,0.5); backdrop-filter: blur(3px); display: flex; align-items: center; justify-content: center; z-index: 200; animation: about-fade 160ms ease; }
    .about-modal { position: relative; width: 360px; max-width: 90vw; background: linear-gradient(180deg, #1c1c22 0%, #121216 100%); color: #fff; border: 1px solid rgba(255,255,255,0.08); border-radius: 18px; padding: 34px 28px 26px; text-align: center; box-shadow: 0 30px 80px rgba(0,0,0,0.5); animation: about-pop 220ms cubic-bezier(.2,.7,.3,1); }
    .about-close { position: absolute; top: 12px; right: 12px; display: inline-flex; align-items: center; justify-content: center; width: 30px; height: 30px; border: none; border-radius: 8px; background: rgba(255,255,255,0.06); color: #bbb; cursor: pointer; }
    .about-close:hover { background: rgba(255,255,255,0.12); color: #fff; }
    .about-badge { width: 60px; height: 60px; margin: 0 auto 14px; border-radius: 15px; background: #fff; display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 14px rgba(0,0,0,0.25); }
    .about-badge img { width: 42px; height: 42px; object-fit: contain; }
    .dev-avatar { width: 76px; height: 76px; margin: 0 auto 14px; border-radius: 50%; object-fit: cover; border: 2px solid rgba(255,255,255,0.15); display: block; }
    .about-title { font-size: 22px; font-weight: 700; letter-spacing: -0.02em; margin: 0 0 4px; }
    .about-tag { font-size: 13px; color: #9a9aa2; margin: 0 0 14px; }
    .about-version { font-size: 13px; color: #d0d0d6; margin-bottom: 14px; display: inline-flex; align-items: center; gap: 8px; }
    .about-chip { font-size: 10px; letter-spacing: 0.05em; text-transform: uppercase; background: var(--accent); color: #fff; border-radius: 20px; padding: 2px 8px; }
    .about-copy { font-size: 13px; color: #a8a8b0; line-height: 1.6; margin: 0 auto 18px; max-width: 30ch; }
    .dev-link { display: inline-flex; align-items: center; gap: 7px; font-size: 13px; font-weight: 500; padding: 9px 16px; border-radius: 10px; background: var(--accent); color: #fff; text-decoration: none; margin-bottom: 18px; transition: transform 140ms ease; }
    .dev-link:hover { transform: translateY(-1px); }
    .about-legal { font-size: 11px; color: #6a6a72; margin: 0; }
    @keyframes about-fade { from { opacity: 0; } to { opacity: 1; } }
    @keyframes about-pop { from { opacity: 0; transform: translateY(12px) scale(0.97); } to { opacity: 1; transform: translateY(0) scale(1); } }
    @media (prefers-reduced-motion: reduce) { .about-scrim, .about-modal { animation: none; } }

    /* Tailor progress spinner + bar */
    .tp-spinner { width: 16px; height: 16px; border: 2px solid var(--border); border-top-color: var(--accent); border-radius: 50%; animation: tp-spin 0.7s linear infinite; }
    @keyframes tp-spin { to { transform: rotate(360deg); } }
    .tp-bar { height: 4px; border-radius: 4px; background: var(--subtle); overflow: hidden; }
    .tp-bar-fill { display: block; height: 100%; background: var(--accent); border-radius: 4px; transition: width 500ms cubic-bezier(.4,0,.2,1); }
    .tp-dot { display: inline-block; width: 7px; height: 7px; border-radius: 50%; background: var(--accent); animation: tp-pulse 1s ease-in-out infinite; }
    @keyframes tp-pulse { 0%,100% { opacity: 1; } 50% { opacity: 0.35; } }
    @media (prefers-reduced-motion: reduce) { .tp-spinner, .tp-dot { animation: none; } }
    .mb-menu { font: inherit; font-size: 13px; color: var(--secondary); background: transparent; border: none; padding: 5px 9px; border-radius: 6px; cursor: pointer; }
    .mb-menu:hover:not(:disabled) { background: var(--subtle); color: var(--text); }
    .mb-menu:disabled { color: var(--muted); cursor: default; }
    .mb-center { display: flex; align-items: center; gap: 10px; justify-content: center; }
    .mb-title { font: inherit; font-size: 13px; font-weight: 500; color: var(--text); background: transparent; border: none; padding: 4px 10px; border-radius: 7px; cursor: pointer; }
    .mb-title:hover { background: var(--subtle); }
    .mb-title-input { font: inherit; font-size: 13px; padding: 4px 10px; border: 1px solid var(--accent); border-radius: 7px; outline: none; }
    .mb-save { font-size: 12px; color: var(--muted); } .mb-save.error { color: var(--danger); } .mb-save.saved { color: var(--success); }
    .mb-right { display: flex; align-items: center; gap: 10px; justify-content: flex-end; }
    .ai-review-bar { display: flex; align-items: center; gap: 7px; padding: 3px 6px 3px 11px; background: rgba(37,99,235,0.06); border: 1px solid rgba(37,99,235,0.2); border-radius: 8px; }
    .ai-review-label { font-size: 12px; color: var(--accent); font-weight: 500; }
    .ai-accept, .ai-reject { display: inline-flex; align-items: center; gap: 4px; font: inherit; font-size: 12px; padding: 4px 8px; border-radius: 6px; border: none; cursor: pointer; }
    .ai-accept { background: var(--accent); color: #fff; } .ai-reject { background: transparent; color: var(--secondary); } .ai-reject:hover { background: var(--subtle); }

    /* ===================== Buttons ===================== */
    .ui-btn { display: inline-flex; align-items: center; gap: 7px; font: inherit; font-size: 13px; font-weight: 500; padding: 7px 13px; border-radius: 9px; cursor: pointer; border: 1px solid transparent; transition: transform 140ms ease, background 140ms ease, border-color 140ms ease; }
    .ui-btn:disabled { opacity: 0.5; cursor: default; }
    .ui-btn.primary { background: #111; color: #fff; } .ui-btn.primary:hover:not(:disabled) { transform: translateY(-1px); background: #292929; }
    .ui-btn.secondary { background: var(--surface); border-color: var(--border); color: var(--text); } .ui-btn.secondary:hover:not(:disabled) { border-color: var(--accent); }
    .ui-btn.ai { background: var(--accent); color: #fff; } .ui-btn.ai:hover:not(:disabled) { transform: translateY(-1px); }
    .ui-btn.ghost { background: transparent; color: var(--secondary); } .ui-btn.ghost:hover:not(:disabled) { background: var(--subtle); color: var(--text); }
    .ui-iconbtn { display: inline-flex; align-items: center; justify-content: center; width: 30px; height: 30px; border: 1px solid transparent; border-radius: 8px; background: transparent; color: var(--secondary); cursor: pointer; transition: background 140ms ease, color 140ms ease; }
    .ui-iconbtn:hover:not(:disabled) { background: var(--subtle); color: var(--text); } .ui-iconbtn:disabled { opacity: 0.4; cursor: default; }

    /* ===================== Left rail (single logo) ===================== */
    .rail { width: 52px; flex-shrink: 0; border-right: 1px solid var(--border); background: #fbfbfa; display: flex; flex-direction: column; align-items: center; padding: 10px 0; gap: 14px; }
    .rail-brand { display: inline-flex; align-items: center; justify-content: center; width: 30px; height: 30px; border-radius: 8px; background: #111; color: #fff; font-weight: 700; font-size: 14px; }
    .rail-items { display: flex; flex-direction: column; gap: 4px; }
    .rail-foot { margin-top: auto; }
    .rail-item { position: relative; display: inline-flex; align-items: center; justify-content: center; width: 38px; height: 38px; border: none; border-radius: 9px; background: transparent; color: var(--secondary); cursor: pointer; transition: background 140ms ease, color 140ms ease; }
    .rail-item:hover:not(:disabled) { background: var(--subtle); color: var(--text); }
    .rail-item.active { background: rgba(37,99,235,0.10); color: var(--accent); }
    .rail-item:disabled { opacity: 0.4; cursor: default; }
    .rail-item[data-label]::after { content: attr(data-label); position: absolute; left: calc(100% + 10px); top: 50%; transform: translateY(-50%) scale(0.96); white-space: nowrap; background: #111; color: #fff; font-size: 12px; padding: 5px 9px; border-radius: 7px; opacity: 0; pointer-events: none; transition: opacity 140ms ease, transform 140ms ease; z-index: 40; }
    .rail-item[data-label]:hover::after { opacity: 1; transform: translateY(-50%) scale(1); }
    .rail-item { text-decoration: none; }
    .rail-divider { width: 24px; height: 1px; background: var(--border); margin: 8px auto; }

    /* ===================== In-shell views (Files / Usage) ===================== */
    .view-scroll { flex: 1; min-width: 0; overflow-y: auto; background: var(--bg); }
    .view { max-width: 960px; margin: 0 auto; padding: 32px 28px 80px; }
    .view-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 20px; margin-bottom: 28px; }
    .view-eyebrow { font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent); font-weight: 600; margin: 0 0 6px; }
    .view-head h1 { font-size: 26px; font-weight: 600; letter-spacing: -0.03em; margin: 0 0 6px; }
    .stat-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-bottom: 32px; }
    @media (max-width: 720px) { .stat-cards { grid-template-columns: 1fr; } }
    .stat-card { background: var(--surface); border: 1px solid var(--border); border-radius: 14px; padding: 16px 18px; display: flex; flex-direction: column; gap: 3px; }
    .sc-label { font-size: 11px; letter-spacing: 0.05em; text-transform: uppercase; color: var(--muted); }
    .sc-value { font-size: 28px; font-weight: 600; letter-spacing: -0.02em; }
    .sc-sub { font-size: 12px; color: var(--muted); }
    .view-head p { color: var(--secondary); margin: 0; max-width: 62ch; line-height: 1.5; font-size: 14px; }
    .view-cta { flex-shrink: 0; font-size: 13px; font-weight: 500; padding: 8px 14px; border: 1px solid var(--border); border-radius: 9px; background: var(--surface); color: var(--text); text-decoration: none; }
    .view-cta:hover { border-color: var(--accent); }
    .view-muted { color: var(--muted); font-size: 14px; }

    .tbl-section { margin-bottom: 32px; }
    .tbl-head-row { display: flex; align-items: center; gap: 8px; margin-bottom: 12px; }
    .tbl-head-row h2 { font-size: 14px; font-weight: 600; margin: 0; }
    .tbl-count { font-size: 12px; color: var(--muted); background: var(--subtle); border-radius: 20px; padding: 1px 8px; }
    .tbl-empty { font-size: 13px; color: var(--muted); background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 20px; }
    .tbl { width: 100%; border-collapse: collapse; background: var(--surface); border: 1px solid var(--border); border-radius: 12px; overflow: hidden; }
    .tbl thead th { text-align: left; font-size: 11px; letter-spacing: 0.04em; text-transform: uppercase; color: var(--muted); font-weight: 600; padding: 11px 14px; border-bottom: 1px solid var(--border); background: #fcfcfb; }
    .tbl tbody td { font-size: 13px; padding: 12px 14px; border-bottom: 1px solid var(--border); vertical-align: middle; }
    .tbl tbody tr:last-child td { border-bottom: none; }
    .tbl tbody tr:hover { background: #fcfcfb; }
    .td-title { font-weight: 500; color: var(--text); }
    .td-muted { color: var(--muted); }
    .ta-r { text-align: right; }
    .pill { display: inline-block; font-size: 12px; padding: 2px 9px; border-radius: 20px; background: rgba(22,128,60,0.08); color: var(--success); }
    .pill.warn { background: rgba(183,121,31,0.1); color: var(--warning); }
    .tag { display: inline-block; font-size: 11.5px; padding: 2px 9px; border-radius: 6px; background: var(--subtle); color: var(--secondary); }
    .row-act { display: inline-flex; align-items: center; gap: 5px; font: inherit; font-size: 12.5px; padding: 5px 9px; margin-left: 6px; border: none; border-radius: 7px; background: transparent; color: var(--accent); cursor: pointer; text-decoration: none; }
    .row-act:hover { background: rgba(37,99,235,0.08); }
    .row-act.danger { color: var(--danger); } .row-act.danger:hover { background: rgba(194,65,65,0.08); }

    .usage-grid { display: flex; flex-direction: column; gap: 20px; max-width: 460px; }
    .usage-card { display: flex; align-items: center; gap: 24px; padding: 22px; background: var(--surface); border: 1px solid var(--border); border-radius: 14px; }
    .usage-nums { display: flex; flex-direction: column; }
    .usage-big { font-size: 38px; font-weight: 600; margin: 0; letter-spacing: -0.03em; }
    .usage-stats { display: flex; flex-direction: column; }
    .stat { display: flex; justify-content: space-between; padding: 12px 4px; border-bottom: 1px solid var(--border); font-size: 14px; }
    .usage-cta { align-self: flex-start; text-decoration: none; }

    /* ===================== Push drawer (layout column) ===================== */
    .drawer { width: 100%; height: 100%; border-right: 1px solid var(--border); background: var(--surface); display: flex; flex-direction: column; min-height: 0; min-width: 0; }
    .drawer-head { display: flex; align-items: center; justify-content: space-between; height: 44px; padding: 0 8px 0 12px; border-bottom: 1px solid var(--border); flex-shrink: 0; }
    .drawer-tabs { display: flex; gap: 2px; }
    .drawer-tab { display: inline-flex; align-items: center; gap: 5px; font: inherit; font-size: 12.5px; font-weight: 500; padding: 5px 9px; border: none; border-radius: 7px; background: transparent; color: var(--secondary); cursor: pointer; }
    .drawer-tab.active { background: var(--subtle); color: var(--text); }
    .drawer-tab:hover:not(.active) { color: var(--text); }

    /* Tailor progress */
    .tailor-progress { display: flex; flex-direction: column; gap: 14px; }
    .tp-head { display: flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 500; color: var(--text); }
    .tp-steps { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
    .tp-step { display: flex; align-items: center; gap: 9px; font-size: 13px; color: var(--muted); }
    .tp-step .tp-mark { width: 15px; text-align: center; }
    .tp-step.done { color: var(--secondary); } .tp-step.done .tp-mark { color: var(--success); }
    .tp-step.active { color: var(--text); font-weight: 500; } .tp-step.active .tp-mark { color: var(--accent); }
    .dr-note.danger { color: var(--danger); }

    /* Saved uploads pick-lists */
    .saved-list { display: flex; flex-direction: column; gap: 4px; margin-top: 8px; }
    .saved-label { font-size: 10px; letter-spacing: 0.05em; text-transform: uppercase; color: var(--muted); }
    .saved-item { display: inline-flex; align-items: center; gap: 6px; text-align: left; font: inherit; font-size: 12px; padding: 6px 8px; border: 1px solid var(--border); border-radius: 7px; background: var(--surface); color: var(--secondary); cursor: pointer; }
    .saved-item:hover { border-color: var(--accent); color: var(--text); }
    .jd-actions { display: flex; justify-content: flex-end; }
    .jd-save { font: inherit; font-size: 12px; padding: 5px 10px; border: 1px solid var(--border); border-radius: 7px; background: var(--surface); color: var(--secondary); cursor: pointer; }
    .jd-save:hover:not(:disabled) { border-color: var(--accent); color: var(--text); } .jd-save:disabled { opacity: 0.5; cursor: default; }

    /* Account modal */
    .modal-scrim { position: fixed; inset: 0; background: rgba(17,17,17,0.35); display: flex; align-items: center; justify-content: center; z-index: 100; }
    .modal { background: #fff; border: 1px solid var(--border); border-radius: 16px; box-shadow: var(--shadow-card); padding: 28px; max-width: 380px; }
    .modal h3 { margin: 0 0 8px; font-size: 18px; }
    .modal p { color: var(--secondary); font-size: 14px; line-height: 1.5; margin: 0 0 20px; }
    .modal-actions { display: flex; gap: 10px; } .modal-actions .ui-btn { text-decoration: none; }
    .drawer-body { flex: 1; overflow-y: auto; padding: 16px 14px; display: flex; flex-direction: column; gap: 18px; }
    .outline { display: flex; flex-direction: column; gap: 1px; }
    .outline-item { text-align: left; font: inherit; font-size: 13px; padding: 7px 10px; border: none; border-radius: 7px; background: transparent; color: var(--secondary); cursor: pointer; }
    .outline-item:hover { background: var(--subtle); color: var(--text); }
    .dr-block { display: flex; flex-direction: column; gap: 10px; }
    .dr-block h4 { font-size: 11px; letter-spacing: 0.05em; text-transform: uppercase; color: var(--muted); margin: 0; }
    .dropzone { display: flex; flex-direction: column; align-items: center; gap: 6px; width: 100%; padding: 20px 12px; border: 1px dashed var(--border); border-radius: 12px; background: var(--surface); color: var(--secondary); font: inherit; font-size: 13px; cursor: pointer; transition: border-color 140ms ease; }
    .dropzone:hover { border-color: var(--accent); } .dropzone .dz-icon { color: var(--muted); }
    .dropzone em { font-style: normal; font-size: 11px; color: var(--muted); } .dropzone .file-name { color: var(--text); font-weight: 500; }
    .jd-input { width: 100%; font: inherit; font-size: 13px; padding: 10px 12px; border: 1px solid var(--border); border-radius: 10px; background: var(--surface); color: var(--text); resize: vertical; line-height: 1.5; }
    .jd-input:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; border-color: transparent; }
    .dr-note { font-size: 12px; color: var(--muted); margin: 0; line-height: 1.5; }
    .ui-btn.dr-cta { width: 100%; justify-content: center; padding: 11px; font-size: 14px; }
    .intel { font-size: 13px; color: var(--secondary); line-height: 1.55; display: flex; flex-direction: column; gap: 16px; }
    .intel-steps p { margin: 0 0 8px; } .intel-steps .muted { color: var(--muted); }
    .intel-gauges { display: flex; align-items: center; justify-content: center; gap: 18px; padding: 4px 0; }
    .gauge { position: relative; } .gauge svg { display: block; }
    .gauge-center { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; }
    .gauge-val { font-size: 20px; font-weight: 600; color: var(--text); } .gauge-val em { font-size: 12px; font-style: normal; color: var(--muted); }
    .gauge-label { font-size: 10px; letter-spacing: 0.04em; text-transform: uppercase; color: var(--muted); }
    .kw-list { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
    .kw { display: inline-flex; align-items: center; gap: 4px; font-size: 12px; padding: 3px 8px; border-radius: 6px; border: 1px solid var(--border); }
    .kw.ok { color: var(--success); border-color: rgba(22,128,60,0.25); background: rgba(22,128,60,0.05); }
    .kw.miss { color: var(--warning); border-color: rgba(183,121,31,0.25); background: rgba(183,121,31,0.05); }
    .opp-list { margin: 0; padding-left: 16px; display: flex; flex-direction: column; gap: 6px; }
    .opp-list li { font-size: 12.5px; color: var(--secondary); line-height: 1.5; }
    .seg { display: flex; gap: 4px; }
    .seg-btn { flex: 1; font: inherit; font-size: 12px; text-transform: capitalize; padding: 7px; border: 1px solid var(--border); border-radius: 8px; background: var(--surface); color: var(--secondary); cursor: pointer; }
    .seg-btn.active { border-color: var(--accent); color: var(--accent); background: rgba(37,99,235,0.05); }

    /* ===================== Workspace split ===================== */
    .workspace { flex: 1; min-width: 0; min-height: 0; display: flex; }
    .workspace > * { flex: 1; min-width: 0; }
    /* react-resizable-panels: ensure panels fill height and clip content */
    .workspace [data-panel] { min-width: 0; overflow: hidden; }
    .split-handle { width: 1px; background: var(--border); position: relative; cursor: col-resize; transition: background 140ms ease; }
    .split-handle::after { content: ""; position: absolute; inset: 0 -4px; }
    .split-handle:hover, .split-handle[data-resize-handle-active] { background: var(--accent); }

    /* ===================== Editor pane ===================== */
    .editor-pane { display: flex; flex-direction: column; height: 100%; min-width: 0; background: var(--surface); }
    .ed-loading { padding: 24px; color: var(--muted); font-size: 13px; }
    .ed-header { display: flex; align-items: center; justify-content: space-between; height: 40px; padding: 0 14px; border-bottom: 1px solid var(--border); flex-shrink: 0; }
    .ed-header-left { display: flex; align-items: center; gap: 12px; }
    .ed-file { font-family: var(--mono); font-size: 12.5px; color: var(--text); }
    .ed-template { font-size: 11px; color: var(--muted); }
    .ed-header-right { display: flex; align-items: center; gap: 10px; }
    .ed-status { display: inline-flex; align-items: center; gap: 5px; font-size: 12px; color: var(--muted); }
    .ed-status.ok { color: var(--success); } .ed-status.err { color: var(--danger); } .ed-status.updating { color: var(--secondary); }
    .ed-compile { display: inline-flex; align-items: center; gap: 6px; font: inherit; font-size: 12.5px; padding: 5px 11px; border: 1px solid var(--border); border-radius: 8px; background: var(--surface); color: var(--text); cursor: pointer; }
    .ed-compile:hover:not(:disabled) { border-color: var(--accent); } .ed-compile:disabled { opacity: 0.5; cursor: default; }
    .ed-host { flex: 1; min-height: 0; overflow: hidden; }
