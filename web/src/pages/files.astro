---
import Dashboard from "@/layouts/Dashboard.astro";
import FilesPage from "@/components/pages/FilesPage.tsx";
import { requireUser } from "@/lib/auth";

export const prerender = false;

if (!(await requireUser(Astro))) return Astro.redirect("/?auth=login", 302);
---

<Dashboard
  title="My files — Aptora"
  description="Reusable resume uploads, saved job descriptions and generated PDF exports."
  path="/files"
>
  <FilesPage client:load />
</Dashboard>
