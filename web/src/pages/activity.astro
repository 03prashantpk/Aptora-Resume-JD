---
import Dashboard from "@/layouts/Dashboard.astro";
import ActivityPage from "@/components/pages/ActivityPage.tsx";
import { requireUser } from "@/lib/auth";

export const prerender = false;

if (!(await requireUser(Astro))) return Astro.redirect("/?auth=login", 302);
---

<Dashboard
  title="Activity — Aptora"
  description="Payments and everything that happened in your workspace — newest first."
  path="/activity"
>
  <ActivityPage client:load />
</Dashboard>
